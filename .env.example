# App
APP_VERSION=1.0.0
# Platform Shell (runtime): wemotoo | yeppi — Nuxt maps this onto runtimeConfig.public.appPlatform.
# Same Docker image; set per deployment (compose / host env). Do not bake a brand into the image.
NUXT_PUBLIC_APP_PLATFORM=wemotoo

# Backend endpoint
BASE_URL=http://localhost:8888/api

# Auth and signing
API_KEY=
REQUEST_SIGNATURE_SECRET=
JWT_SECRET=
